# hello-jev: Jev 呼び出し用の認証情報を読み込む。
#
# このファイルに秘密は書かない。コミットしてよい。
# 呼び出し経路は 3 つ。TYPESAFE_API_KEY > AI_GATEWAY_API_KEY > Cloudflare の順に優先。
#
#   A. TypeSafe 直 API
#      TYPESAFE_API_KEY を設定する。Cloudflare / Vercel を挟まない。
#
#   B. Vercel AI Gateway（実用的）
#      AI_GATEWAY_API_KEY を設定する。無料枠に Jev が含まれる。
#      ただしカード登録が前提。無いと 403 customer_verification_required になる。
#      登録は AI Gateway のクレジット用モーダル（.../ai?modal=top-up）から行う。
#      Pro アップグレード（$20/月）は不要。
#
#   C. Cloudflare Workers AI 経由
#      CLOUDFLARE_ACCOUNT_ID と CLOUDFLARE_API_TOKEN を設定する。
#      typesafe/jev は Third-party モデルなので、無料枠では 402 で止まる。
#
# 秘密の置き場所は 3 通り。上から順に試し、先に成功したものを使う。
#
#   1. 親シェルで既に export 済み（direnv は何もしない）
#   2. 1Password CLI — 下の op:// パスのコメントを外す。
#      自分の vault / アイテム名 / フィールド名に合わせて書き換える。
#   3. リポジトリ外の env ファイル（既定）
#      ~/.config/hello-jev/env に KEY=VALUE を書く。chmod 600 にしておく。
#      リポジトリの外に置くので、誤ってコミットする事故が起きない。

# --- 2. 1Password -----------------------------------------------------------
# op が未サインインのままだと direnv allow / シェル入場時に固まることがある。
# 使い始めるまではコメントアウトしておく。
#
# export TYPESAFE_API_KEY=$(op read "op://Private/typesafe/api_key")
# export AI_GATEWAY_API_KEY=$(op read "op://Private/vercel/ai_gateway_api_key")
# export CLOUDFLARE_ACCOUNT_ID=$(op read "op://Private/cloudflare-workers-ai/account_id")
# export CLOUDFLARE_API_TOKEN=$(op read "op://Private/cloudflare-workers-ai/credential")

# --- 3. リポジトリ外の env ファイル -----------------------------------------
dotenv_if_exists "$HOME/.config/hello-jev/env"

# --- 確認 -------------------------------------------------------------------
if [[ -n ${TYPESAFE_API_KEY:-} ]]; then
  log_status "hello-jev: TypeSafe 直 API で呼ぶ"
elif [[ -n ${AI_GATEWAY_API_KEY:-} ]]; then
  log_status "hello-jev: Vercel AI Gateway 経由で呼ぶ（クレジット制）"
elif [[ -n ${CLOUDFLARE_ACCOUNT_ID:-} && -n ${CLOUDFLARE_API_TOKEN:-} ]]; then
  log_status "hello-jev: Cloudflare Workers AI 経由で呼ぶ（クレジットが必要）"
fi
